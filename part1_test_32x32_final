
.text
.globl main

# ============================================================
# 32 x 32 TEST
# All 1,024 matrix elements are initialized to 1.
#
# Expected:
#   Every column sum = 32
#   Overall overflow flag = 0
# ============================================================

main:
    # Matrix base address = 1024
    addi s1, zero, 1024

    # Output base address = 8192
    lui s2, 2

    # Matrix dimensions = 32 rows x 32 columns
    addi s3, zero, 32

    # Initialize 1,024 matrix elements to 1
    addi t0, s1, 0
    addi t1, zero, 1024
    addi t2, zero, 1

initialize_loop:
    beq t1, zero, initialize_done
    sw t2, 0(t0)
    addi t0, t0, 4
    addi t1, t1, -1
    jal zero, initialize_loop

initialize_done:
    # sum_columns(matrix, rows, columns, output)
    addi a0, s1, 0
    addi a1, s3, 0
    addi a2, s3, 0
    addi a3, s2, 0
    jal ra, sum_columns

    # Check selected column sums
    lw t2, 0(s2)        # Column 0: expected 32
    lw t3, 60(s2)       # Column 15: expected 32
    lw t4, 124(s2)      # Column 31: expected 32
    lw t5, 128(s2)      # Overflow flag: expected 0

    ebreak


# ============================================================
# sum_columns(a0, a1, a2, a3)
#
# a0 = matrix base address
# a1 = number of rows
# a2 = number of columns
# a3 = output base address
#
# Stores each column sum followed by an overflow flag.
# ============================================================

sum_columns:
    # Save ra and s0-s7
    addi sp, sp, -36
    sw ra, 32(sp)
    sw s0, 28(sp)
    sw s1, 24(sp)
    sw s2, 20(sp)
    sw s3, 16(sp)
    sw s4, 12(sp)
    sw s5, 8(sp)
    sw s6, 4(sp)
    sw s7, 0(sp)

    addi s0, a0, 0       # Matrix base
    addi s1, a1, 0       # Rows
    addi s2, a2, 0       # Columns
    addi s3, a3, 0       # Output base
    addi s4, zero, 0     # Current column
    addi s6, zero, 0     # Overall overflow flag

    # Row stride = columns * 4 bytes
    slli s7, s2, 2

column_loop:
    bge s4, s2, sum_columns_done

    # Reset current column sum
    addi s5, zero, 0

    # First element address = matrix base + column * 4
    slli t0, s4, 2
    addi a0, s0, 0
    addi a1, t0, 0
    jal ra, do_add
    addi t0, a0, 0

    # Count rows
    addi t1, s1, 0

row_loop:
    beq t1, zero, column_done

    # Add current matrix element to the sum
    lw a1, 0(t0)
    addi a0, s5, 0
    jal ra, do_add
    addi s5, a0, 0

    # Preserve any overflow from adding matrix data
    beq a2, zero, element_no_overflow
    addi s6, zero, 1

element_no_overflow:
    # Advance to the next row, same column
    addi a0, t0, 0
    addi a1, s7, 0
    jal ra, do_add
    addi t0, a0, 0

    addi t1, t1, -1
    jal zero, row_loop

column_done:
    # Store this column's sum
    slli t0, s4, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add
    sw s5, 0(a0)

    addi s4, s4, 1
    jal zero, column_loop

sum_columns_done:
    # Store overflow flag after the final column sum
    slli t0, s2, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add
    sw s6, 0(a0)

    # Restore saved registers
    lw s7, 0(sp)
    lw s6, 4(sp)
    lw s5, 8(sp)
    lw s4, 12(sp)
    lw s3, 16(sp)
    lw s2, 20(sp)
    lw s1, 24(sp)
    lw s0, 28(sp)
    lw ra, 32(sp)
    addi sp, sp, 36

    jalr zero, 0(ra)


# ============================================================
# do_add(a0, a1)
#
# Returns:
#   a0 = 32-bit unsigned sum
#   a2 = 1 if unsigned overflow occurred, otherwise 0
#
# Uses XOR, AND, and shifts rather than add/sub instructions.
# ============================================================

do_add:
    addi sp, sp, -20
    sw t0, 0(sp)
    sw t1, 4(sp)
    sw t2, 8(sp)
    sw t3, 12(sp)
    sw t6, 16(sp)

    # Preserve original first operand
    addi t6, a0, 0
    addi t0, a0, 0
    addi t1, a1, 0

software_add_loop:
    xor t2, t0, t1
    and t3, t0, t1
    slli t3, t3, 1

    addi t0, t2, 0
    addi t1, t3, 0
    bne t1, zero, software_add_loop

    # Return the 32-bit sum
    addi a0, t0, 0

    # Detect unsigned overflow
    sltu a2, a0, t6

    # Restore temporary registers
    lw t0, 0(sp)
    lw t1, 4(sp)
    lw t2, 8(sp)
    lw t3, 12(sp)
    lw t6, 16(sp)
    addi sp, sp, 20

    jalr zero, 0(ra)
