
.text
.globl main

main:
    # Matrix base address = 1024
    addi s1, zero, 1024

    # Output base address = 8192
    lui s2, 2

    # Matrix:
    # [0, 1, 2]
    # [1, 2, 3]

    addi t0, s1, 0

    addi t1, zero, 0
    sw t1, 0(t0)

    addi t1, zero, 1
    sw t1, 4(t0)

    addi t1, zero, 2
    sw t1, 8(t0)

    addi t0, s1, 12

    addi t1, zero, 1
    sw t1, 0(t0)

    addi t1, zero, 2
    sw t1, 4(t0)

    addi t1, zero, 3
    sw t1, 8(t0)

    # Call sum_columns(matrix, rows, columns, output)
    addi a0, s1, 0
    addi a1, zero, 2
    addi a2, zero, 3
    addi a3, s2, 0

    jal ra, sum_columns

    # Expected column sums: 1, 3, 5
    # Expected overflow flag: 0
    lw t2, 0(s2)
    lw t3, 4(s2)
    lw t4, 8(s2)
    lw t5, 12(s2)

    ebreak


# ------------------------------------------------------------
# Part 2: Memory-aware sum_columns
#
# Inputs:
#   a0 = matrix base address
#   a1 = number of rows
#   a2 = number of columns
#   a3 = output base address
#
# Traverses the matrix row by row.
# Stores one sum per column, followed by an overflow flag.
# ------------------------------------------------------------
sum_columns:
    # Save return address and saved registers
    addi sp, sp, -40
    sw ra, 36(sp)
    sw s0, 32(sp)
    sw s1, 28(sp)
    sw s2, 24(sp)
    sw s3, 20(sp)
    sw s4, 16(sp)
    sw s5, 12(sp)
    sw s6, 8(sp)

    addi s0, a0, 0       # Matrix pointer
    addi s1, a1, 0       # Row count
    addi s2, a2, 0       # Column count
    addi s3, a3, 0       # Output base
    addi s4, zero, 0     # Current row
    addi s6, zero, 0     # Overall overflow flag

    # Initialize each column sum to zero
    addi t1, s3, 0
    addi t2, s2, 0

initialize_loop:
    beq t2, zero, initialize_done

    sw zero, 0(t1)
    addi t1, t1, 4
    addi t2, t2, -1

    jal zero, initialize_loop

initialize_done:
    # Start at the first matrix element
    addi t0, s0, 0

row_loop:
    # Stop when all rows have been processed
    bge s4, s1, rows_done

    # Reset output pointer for each row
    addi t1, s3, 0
    addi s5, s2, 0       # Remaining columns in this row

column_loop:
    beq s5, zero, row_done

    # Add matrix[row][column] to its column sum
    lw a0, 0(t1)
    lw a1, 0(t0)
    jal ra, do_add

    # Store the updated column sum
    sw a0, 0(t1)

    # Remember any data-sum overflow
    beq a2, zero, no_overflow
    addi s6, zero, 1

no_overflow:
    # Move to the next adjacent matrix element
    addi t0, t0, 4

    # Move to the next column sum
    addi t1, t1, 4
    addi s5, s5, -1

    jal zero, column_loop

row_done:
    addi s4, s4, 1
    jal zero, row_loop

rows_done:
    # Store overflow flag after all column sums
    slli t0, s2, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add

    sw s6, 0(a0)

    # Restore saved registers
    lw s6, 8(sp)
    lw s5, 12(sp)
    lw s4, 16(sp)
    lw s3, 20(sp)
    lw s2, 24(sp)
    lw s1, 28(sp)
    lw s0, 32(sp)
    lw ra, 36(sp)

    addi sp, sp, 40
    jalr zero, 0(ra)


# ------------------------------------------------------------
# do_add(a0, a1)
#
# Returns:
#   a0 = 32-bit unsigned sum
#   a2 = 1 if unsigned overflow occurred; otherwise 0
#
# Emulates addition using XOR, AND, and shifts.
# Does not use the RISC-V add or sub instructions.
# ------------------------------------------------------------
do_add:
    addi sp, sp, -20
    sw t0, 0(sp)
    sw t1, 4(sp)
    sw t2, 8(sp)
    sw t3, 12(sp)
    sw t6, 16(sp)

    # Preserve original first operand
    addi t6, a0, 0
    addi t0, a0, 0
    addi t1, a1, 0

software_add_loop:
    xor t2, t0, t1
    and t3, t0, t1
    slli t3, t3, 1

    addi t0, t2, 0
    addi t1, t3, 0

    bne t1, zero, software_add_loop

    # Return the 32-bit sum
    addi a0, t0, 0

    # Detect unsigned overflow
    sltu a2, a0, t6

    # Restore temporary registers
    lw t0, 0(sp)
    lw t1, 4(sp)
    lw t2, 8(sp)
    lw t3, 12(sp)
    lw t6, 16(sp)

    addi sp, sp, 20
    jalr zero, 0(ra)
