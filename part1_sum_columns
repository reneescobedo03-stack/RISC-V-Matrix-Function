
.text
.globl main

main:
    # Matrix base address = 1024
    addi s1, zero, 1024

    # Output base address = 8192
    lui s2, 2

    # Matrix row 0: [0xFFFFFFFF, 2, 3]
    addi t0, s1, 0
    addi t1, zero, -1
    sw t1, 0(t0)
    addi t1, zero, 2
    sw t1, 4(t0)
    addi t1, zero, 3
    sw t1, 8(t0)

    # Matrix row 1: [1, 4, 5]
    addi t0, s1, 12
    addi t1, zero, 1
    sw t1, 0(t0)
    addi t1, zero, 4
    sw t1, 4(t0)
    addi t1, zero, 5
    sw t1, 8(t0)

    # Call sum_columns(matrix, rows, columns, output)
    addi a0, s1, 0
    addi a1, zero, 2
    addi a2, zero, 3
    addi a3, s2, 0
    jal ra, sum_columns

    # Expected: t2=0, t3=6, t4=8, t5=1
    lw t2, 0(s2)
    lw t3, 4(s2)
    lw t4, 8(s2)
    lw t5, 12(s2)

    ebreak


# ============================================================
# sum_columns(a0, a1, a2, a3)
# a0 = matrix base
# a1 = rows
# a2 = columns
# a3 = output base
#
# Stores column sums followed by an overall overflow flag.
# ============================================================

sum_columns:
    # Save ra and s0-s7 (9 registers = 36 bytes)
    addi sp, sp, -36
    sw ra, 32(sp)
    sw s0, 28(sp)
    sw s1, 24(sp)
    sw s2, 20(sp)
    sw s3, 16(sp)
    sw s4, 12(sp)
    sw s5, 8(sp)
    sw s6, 4(sp)
    sw s7, 0(sp)

    addi s0, a0, 0       # Matrix base
    addi s1, a1, 0       # Number of rows
    addi s2, a2, 0       # Number of columns
    addi s3, a3, 0       # Output base
    addi s4, zero, 0     # Current column
    addi s6, zero, 0     # Overall overflow flag

    # Row stride = columns * 4 bytes
    slli s7, s2, 2

column_loop:
    bge s4, s2, sum_columns_done

    # Initialize this column's sum
    addi s5, zero, 0

    # Address of first element in this column
    slli t0, s4, 2
    addi a0, s0, 0
    addi a1, t0, 0
    jal ra, do_add
    addi t0, a0, 0

    addi t1, s1, 0       # Rows remaining

row_loop:
    beq t1, zero, column_done

    # Sum += matrix element
    lw a1, 0(t0)
    addi a0, s5, 0
    jal ra, do_add
    addi s5, a0, 0

    # Remember overflow from the data sum
    beq a2, zero, element_no_overflow
    addi s6, zero, 1

element_no_overflow:
    # Advance to the same column in the next row
    addi a0, t0, 0
    addi a1, s7, 0
    jal ra, do_add
    addi t0, a0, 0

    addi t1, t1, -1
    jal zero, row_loop

column_done:
    # Store sum at output + column * 4
    slli t0, s4, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add
    sw s5, 0(a0)

    addi s4, s4, 1
    jal zero, column_loop

sum_columns_done:
    # Store overflow flag after all column sums
    slli t0, s2, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add
    sw s6, 0(a0)

    # Restore saved registers
    lw s7, 0(sp)
    lw s6, 4(sp)
    lw s5, 8(sp)
    lw s4, 12(sp)
    lw s3, 16(sp)
    lw s2, 20(sp)
    lw s1, 24(sp)
    lw s0, 28(sp)
    lw ra, 32(sp)
    addi sp, sp, 36

    jalr zero, 0(ra)


# ============================================================
# do_add(a0, a1)
# Returns a0 = 32-bit sum
# Returns a2 = 1 if unsigned overflow, otherwise 0
#
# Uses XOR, AND, and shifts instead of add/sub instructions.
# Preserves the temporary registers it uses.
# ============================================================

do_add:
    addi sp, sp, -20
    sw t0, 0(sp)
    sw t1, 4(sp)
    sw t2, 8(sp)
    sw t3, 12(sp)
    sw t6, 16(sp)

    addi t6, a0, 0
    addi t0, a0, 0
    addi t1, a1, 0

software_add_loop:
    xor t2, t0, t1
    and t3, t0, t1
    slli t3, t3, 1

    addi t0, t2, 0
    addi t1, t3, 0
    bne t1, zero, software_add_loop

    addi a0, t0, 0

    # Unsigned overflow: result < original first operand
    sltu a2, a0, t6

    lw t0, 0(sp)
    lw t1, 4(sp)
    lw t2, 8(sp)
    lw t3, 12(sp)
    lw t6, 16(sp)
    addi sp, sp, 20

    jalr zero, 0(ra)
