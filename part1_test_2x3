
.text
.globl main

main:
    # Matrix base address = 1024
    addi s1, zero, 1024

    # Output base address = 8192
    lui s2, 2

    # Initialize the 2 x 3 matrix:
    # Row 0: 0, 1, 2
    # Row 1: 1, 2, 3

    addi t0, s1, 0

    sw zero, 0(t0)

    addi t1, zero, 1
    sw t1, 4(t0)

    addi t1, zero, 2
    sw t1, 8(t0)

    addi t0, s1, 12

    addi t1, zero, 1
    sw t1, 0(t0)

    addi t1, zero, 2
    sw t1, 4(t0)

    addi t1, zero, 3
    sw t1, 8(t0)

    # Call sum_columns(matrix, rows, columns, output)
    addi a0, s1, 0
    addi a1, zero, 2
    addi a2, zero, 3
    addi a3, s2, 0
    jal ra, sum_columns

    # Read column sums
    lw t2, 0(s2)        # Expected: 1
    lw t3, 4(s2)        # Expected: 3
    lw t4, 8(s2)        # Expected: 5

    # Read overall overflow flag
    lw t5, 12(s2)       # Expected: 0

    ebreak


# ------------------------------------------------------------
# sum_columns(matrix, rows, columns, output)
# a0 = matrix base
# a1 = number of rows
# a2 = number of columns
# a3 = output base
# ------------------------------------------------------------
sum_columns:
    addi sp, sp, -32
    sw ra, 28(sp)
    sw s0, 24(sp)
    sw s1, 20(sp)
    sw s2, 16(sp)
    sw s3, 12(sp)
    sw s4, 8(sp)
    sw s5, 4(sp)
    sw s6, 0(sp)

    addi s0, a0, 0
    addi s1, a1, 0
    addi s2, a2, 0
    addi s3, a3, 0
    addi s4, zero, 0
    addi s6, zero, 0

column_loop:
    bge s4, s2, sum_columns_done

    addi s5, zero, 0

    # First element address = matrix base + column * 4
    slli t0, s4, 2
    addi a0, s0, 0
    addi a1, t0, 0
    jal ra, do_add
    addi t0, a0, 0

    # Row stride = columns * 4 bytes
    slli t1, s2, 2
    addi t2, s1, 0

row_loop:
    beq t2, zero, column_done

    # Save row-loop state
    addi sp, sp, -16
    sw t0, 12(sp)
    sw t1, 8(sp)
    sw t2, 4(sp)
    sw s6, 0(sp)

    # Add matrix element to running sum
    lw a1, 0(t0)
    addi a0, s5, 0
    jal ra, do_add
    addi s5, a0, 0

    # Track overflow
    lw s6, 0(sp)
    beq a2, zero, element_no_overflow
    addi s6, zero, 1

element_no_overflow:
    # Restore row-loop state
    lw t2, 4(sp)
    lw t1, 8(sp)
    lw t0, 12(sp)
    addi sp, sp, 16

    # Advance to next row using do_add
    addi a0, t0, 0
    addi a1, t1, 0
    jal ra, do_add
    addi t0, a0, 0

    addi t2, t2, -1
    jal zero, row_loop

column_done:
    # Output address = output base + column * 4
    slli t0, s4, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add

    # Store column sum
    sw s5, 0(a0)

    addi s4, s4, 1
    jal zero, column_loop

sum_columns_done:
    # Address of overflow flag = output + columns * 4
    slli t0, s2, 2
    addi a0, s3, 0
    addi a1, t0, 0
    jal ra, do_add

    sw s6, 0(a0)

    # Restore saved registers
    lw s6, 0(sp)
    lw s5, 4(sp)
    lw s4, 8(sp)
    lw s3, 12(sp)
    lw s2, 16(sp)
    lw s1, 20(sp)
    lw s0, 24(sp)
    lw ra, 28(sp)
    addi sp, sp, 32

    jalr zero, 0(ra)


# ------------------------------------------------------------
# do_add(a0, a1)
# Returns:
#   a0 = 32-bit unsigned sum
#   a2 = 1 if unsigned overflow, otherwise 0
# ------------------------------------------------------------
do_add:
    addi sp, sp, -20
    sw t0, 0(sp)
    sw t1, 4(sp)
    sw t2, 8(sp)
    sw t3, 12(sp)
    sw t6, 16(sp)

    # Preserve original first operand
    addi t6, a0, 0
    addi t0, a0, 0
    addi t1, a1, 0

software_add_loop:
    xor t2, t0, t1
    and t3, t0, t1
    slli t3, t3, 1

    addi t0, t2, 0
    addi t1, t3, 0

    bne t1, zero, software_add_loop

    # Return sum
    addi a0, t0, 0

    # Unsigned overflow: result < original first operand
    sltu a2, a0, t6

    # Restore temporary registers
    lw t0, 0(sp)
    lw t1, 4(sp)
    lw t2, 8(sp)
    lw t3, 12(sp)
    lw t6, 16(sp)
    addi sp, sp, 20

    jalr zero, 0(ra)
