
.text
.globl main

main:
    # Test: 0xFFFFFFFF + 1
    addi a0, zero, -1
    addi a1, zero, 1

    jal ra, do_add

    # Expected:
    # a0 = 0x00000000
    # a2 = 1

    ebreak


# ------------------------------------------------------------
# do_add(a0, a1)
# Returns:
#   a0 = 32-bit unsigned sum
#   a2 = 1 if unsigned overflow occurred, otherwise 0
#
# Uses XOR, AND, and shifts instead of hardware add/sub.
# ------------------------------------------------------------
do_add:
    addi sp, sp, -20
    sw t0, 0(sp)
    sw t1, 4(sp)
    sw t2, 8(sp)
    sw t3, 12(sp)
    sw t6, 16(sp)

    # Preserve original first operand
    addi t6, a0, 0
    addi t0, a0, 0
    addi t1, a1, 0

software_add_loop:
    xor t2, t0, t1
    and t3, t0, t1
    slli t3, t3, 1

    addi t0, t2, 0
    addi t1, t3, 0

    bne t1, zero, software_add_loop

    # Return sum
    addi a0, t0, 0

    # Unsigned overflow: result < original first operand
    sltu a2, a0, t6

    # Restore temporary registers
    lw t0, 0(sp)
    lw t1, 4(sp)
    lw t2, 8(sp)
    lw t3, 12(sp)
    lw t6, 16(sp)
    addi sp, sp, 20

    jalr zero, 0(ra)
